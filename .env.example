# ==============================================================================
# AutoOps — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize for local development.
# IMPORTANT: .env is git-ignored. NEVER commit real secrets to version control.
# ==============================================================================

# Nagios Observability Dashboard Credentials
NAGIOSADMIN_USER=nagiosadmin
NAGIOSADMIN_PASS=ChangeMeToAStrongPassword123!
NAGIOS_TIMEZONE=UTC

# Application Settings
APP_PORT=5000
NAGIOS_PORT=8080
ENVIRONMENT=development
